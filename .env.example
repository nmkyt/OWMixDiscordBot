# Скопируйте этот файл в .env и заполните своими значениями.
# .env в git не коммитится (см. .gitignore).

# Токен Discord-бота из Discord Developer Portal:
# https://discord.com/developers/applications -> ваше приложение -> Bot -> Token
BOT_TOKEN=

# Строка подключения к PostgreSQL в формате SQLAlchemy:
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/owmix

# Discord ID администраторов бота через запятую (им доступны !check, !create_lobby,
# !mix_stop и другие админ-команды). Узнать свой ID: Discord -> Настройки пользователя ->
# Расширенные настройки -> Режим разработчика, затем ПКМ по себе -> "Копировать ID".
ADMIN_IDS=111111111111111111,222222222222222222
